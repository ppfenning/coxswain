# The component suites, each from its own folder (their tests import sibling test modules by name).
# The three pytest lines are narrowed to the tests a patch can affect; the full suites run once at the level and ticket gate, from .agent/cartridge.yaml.
# The last line is CI's "clean (no personal reference)" step, plus a refusal of files under build/.
# --require-names fails the lane when COXSWAIN_CLEAN_DENY is unset, so the names rule is never skipped silently:
# the lane host must export it (the same regex as the CI secret), or a host name passes here and fails CI.
cd src/tools && pytest -q -n auto
cd src/graphs && pytest -q -n auto
cd src/cartridges && pytest -q -n auto
python .github/check_clean.py . --require-names
