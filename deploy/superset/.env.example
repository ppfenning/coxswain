# Copy to .env and replace every placeholder. Never commit the copy.
# Every variable is required; superset_config.py refuses an unset one or a leftover change-me.

# Optional: Postgres store URL (postgresql://user:pw@host:5432/db). Empty means Superset reads cox.db.
COXSWAIN_STORE_URL=

# Optional: S3-compatible endpoint for the Garage-backed Iceberg lake. Empty skips the lake entirely.
COXSWAIN_S3_ENDPOINT=http://garage:3900
# Access key id for the endpoint above.
COXSWAIN_S3_KEY_ID=change-me
# Secret access key for the endpoint above.
COXSWAIN_S3_SECRET=change-me
# Region DuckDB sends with each S3 request; Garage accepts any string, "garage" is the default here and in code.
COXSWAIN_S3_REGION=garage

# Signs Superset sessions. Generate one with: openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me

# Login for the single admin user that superset-init creates.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
